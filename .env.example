# App
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=compendium
# true on managed providers (e.g. Neon) that require SSL
DB_SSL=false

# JWT
JWT_SECRET=YOUR_SECRET_KEY
JWT_TOKEN_AUDIENCE=localhost:3000
JWT_TOKEN_ISSUER=localhost:3000
JWT_ACCESS_TOKEN_TTL=3600
JWT_REFRESH_TOKEN_TTL=86400

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# true on managed providers (e.g. Upstash) that require TLS
REDIS_TLS=false
